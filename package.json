{
  "name": "coastline",
  "version": "0.1.0",
  "private": true,
  "description": "Coastline - Cox's Bazar beach services and discovery demonstrator",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @coastline/api^... build && pnpm --parallel --filter @coastline/api --filter @coastline/web dev",
    "dev:api": "pnpm --filter @coastline/api^... build && pnpm --filter @coastline/api dev",
    "dev:web": "pnpm --filter @coastline/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,yaml,yml}\"",
    "db:generate": "pnpm --filter @coastline/db db:generate",
    "db:migrate": "pnpm --filter @coastline/db db:migrate",
    "db:migrate:dev": "pnpm --filter @coastline/db db:migrate:dev",
    "db:seed": "pnpm --filter @coastline/db db:seed",
    "db:validate": "pnpm --filter @coastline/db db:validate",
    "db:reset": "pnpm --filter @coastline/db db:reset",
    "postinstall": "pnpm --filter @coastline/db db:generate"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
