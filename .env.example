NODE_ENV=development
APP_ENV=local
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Server-side target used by the Next.js rewrite in apps/web. Set in the web process env.
API_INTERNAL_URL=http://127.0.0.1:3001
# Comma-separated allowlist. Falls back to WEB_ORIGIN when unset.
CORS_ORIGINS=http://localhost:3000
DEMO_AUTH_ENABLED=true
# Testing aid: allow ordering food to a sunbed outside booked hours and kitchen hours. Never in production.
DINING_IGNORE_TIME_RULES=false
DATABASE_URL=postgresql://coastline_app:dev_0bac4f806eae423aa5869ebf7c2f2c927f08cb5d@127.0.0.1:5432/coastline_dev?schema=public
