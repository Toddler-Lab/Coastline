// Coastline — beach demonstrator catalogue, hourly slots, orders and mock payments.
//
// Conventions:
// - UUID primary keys; timestamptz columns stored in UTC.
// - Money is integer minor units (BDT poisha) plus an ISO currency code.
// - Human-facing codes (beach point, sunbed, order) are immutable once issued.
// - Occupancy is one row per sunbed per hour in `booking_slots`; the partial
//   unique index that prevents double booking is added in the SQL migration
//   because Prisma cannot express it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TOURIST
  ADMIN
}

enum SunbedStatus {
  AVAILABLE
  OUT_OF_SERVICE
  RETIRED
}

enum HotelZone {
  KOLATOLI
  SUGANDHA
  LABONI
  HIMCHARI
  PECHARDWIP
  INANI
}

enum HotelRoomStatus {
  AVAILABLE
  MAINTENANCE
  RETIRED
}

enum OrderStatus {
  CONFIRMED
  CANCELLED
}

enum OrderItemStatus {
  RESERVED
  CHECKED_IN
  CANCELLED
}

enum PaymentType {
  CHARGE
  REFUND
}

enum PaymentStatus {
  SUCCEEDED
}

enum DiningVenueKind {
  RESTAURANT
  SEAFOOD_KITCHEN
  BEACH_STALL
}

enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  CANCELLED
}

enum FoodOrderStatus {
  PLACED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String?  @unique
  role      UserRole @default(TOURIST)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders                 Order[]        @relation("OrderTourist")
  cancelledOrders        Order[]        @relation("OrderCancelledBy")
  checkedInItems         OrderItem[]    @relation("OrderItemCheckedInBy")
  checkedInHotelBookings HotelBooking[] @relation("HotelBookingCheckedInBy")
  auditEvents            AuditEvent[]

  // Dining
  managedVenues          DiningVenue[]      @relation("VenueVendor")
  reservations           TableReservation[] @relation("ReservationTourist")
  cancelledReservations  TableReservation[] @relation("ReservationCancelledBy")
  checkedInReservations  TableReservation[] @relation("ReservationCheckedInBy")
  foodOrders             FoodOrder[]        @relation("FoodOrderTourist")
  cancelledFoodOrders    FoodOrder[]        @relation("FoodOrderCancelledBy")

  @@map("users")
}

model BeachPoint {
  id                      String   @id @default(uuid()) @db.Uuid
  code                    String   @unique
  name                    String
  description             String?
  latitude                Float
  longitude               Float
  openHour                Int      @map("open_hour")
  closeHour               Int      @map("close_hour")
  defaultHourlyPriceMinor Int      @map("default_hourly_price_minor")
  currency                String   @default("BDT") @db.Char(3)
  sortOrder               Int      @default(0) @map("sort_order")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sunbeds      Sunbed[]
  diningVenues DiningVenue[]

  @@map("beach_points")
}

model Sunbed {
  id               String       @id @default(uuid()) @db.Uuid
  beachPointId     String       @map("beach_point_id") @db.Uuid
  seq              Int
  code             String       @unique
  hourlyPriceMinor Int          @map("hourly_price_minor")
  currency         String       @default("BDT") @db.Char(3)
  status           SunbedStatus @default(AVAILABLE)
  note             String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  beachPoint BeachPoint  @relation(fields: [beachPointId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  slots      BookingSlot[]

  @@unique([beachPointId, seq])
  @@index([beachPointId, status])
  @@map("sunbeds")
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  publicRef    String      @unique @map("public_ref")
  touristId    String      @map("tourist_id") @db.Uuid
  status       OrderStatus @default(CONFIRMED)
  subtotalMinor Int        @map("subtotal_minor")
  totalMinor   Int         @map("total_minor")
  currency     String      @default("BDT") @db.Char(3)
  placedAt     DateTime    @default(now()) @map("placed_at") @db.Timestamptz(6)
  cancelledAt  DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?     @map("cancel_reason")
  cancelledById String?    @map("cancelled_by_id") @db.Uuid

  tourist       User           @relation("OrderTourist", fields: [touristId], references: [id], onDelete: Restrict)
  cancelledBy   User?          @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items         OrderItem[]
  hotelBookings HotelBooking[]
  payments      Payment[]

  @@index([touristId, placedAt])
  @@index([status, placedAt])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  sunbedId         String          @map("sunbed_id") @db.Uuid
  beachPointCode   String          @map("beach_point_code")
  beachPointName   String          @map("beach_point_name")
  sunbedCode       String          @map("sunbed_code")
  startAt          DateTime        @map("start_at") @db.Timestamptz(6)
  endAt            DateTime        @map("end_at") @db.Timestamptz(6)
  unitPriceMinor   Int             @map("unit_price_minor")
  totalMinor       Int             @map("total_minor")
  status           OrderItemStatus @default(RESERVED)
  checkedInAt      DateTime?       @map("checked_in_at") @db.Timestamptz(6)
  checkedInById    String?         @map("checked_in_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sunbed      Sunbed        @relation(fields: [sunbedId], references: [id], onDelete: Restrict)
  checkedInBy User?         @relation("OrderItemCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  slots       BookingSlot[]
  foodOrders  FoodOrder[]

  @@index([orderId])
  @@index([sunbedId, startAt])
  @@index([startAt, status])
  @@map("order_items")
}

model BookingSlot {
  id          String   @id @default(uuid()) @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  sunbedId    String   @map("sunbed_id") @db.Uuid
  slotStart   DateTime @map("slot_start") @db.Timestamptz(6)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  sunbed    Sunbed    @relation(fields: [sunbedId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, slotStart])
  @@index([sunbedId, slotStart])
  @@index([slotStart])
  @@map("booking_slots")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  // Exactly one parent is set (CHECK payments_single_parent_check in SQL).
  orderId       String?       @map("order_id") @db.Uuid
  reservationId String?       @map("reservation_id") @db.Uuid
  foodOrderId   String?       @map("food_order_id") @db.Uuid
  type        PaymentType
  provider    String        @default("MOCK")
  status      PaymentStatus @default(SUCCEEDED)
  amountMinor Int           @map("amount_minor")
  currency    String        @default("BDT") @db.Char(3)
  externalRef String?       @unique @map("external_ref")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order       Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reservation TableReservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  foodOrder   FoodOrder?        @relation(fields: [foodOrderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([reservationId, createdAt])
  @@index([foodOrderId, createdAt])
  @@map("payments")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  details     Json?    @db.JsonB
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

model Hotel {
  id               String          @id @default(uuid()) @db.Uuid
  slug             String          @unique
  name             String
  banglaName       String?         @map("bangla_name")
  zone             HotelZone
  address          String
  latitude         Float
  longitude        Float
  starRating       Int             @default(3) @map("star_rating")
  featuredImage    String          @map("featured_image")
  galleryImages    Json            @default("[]") @map("gallery_images")
  description      String
  phone            String
  email            String?
  checkInTime      String          @default("14:00") @map("check_in_time")
  checkOutTime     String          @default("11:00") @map("check_out_time")
  amenities        Json            @default("[]")
  nearestBeachCode String          @map("nearest_beach_code")
  distanceMeters   Int             @map("distance_meters")
  isFeatured       Boolean         @default(false) @map("is_featured")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  roomTypes        RoomType[]
  hotelRooms       HotelRoom[]
  hotelBookings    HotelBooking[]

  @@index([zone, isActive])
  @@index([isFeatured])
  @@map("hotels")
}

model RoomType {
  id             String          @id @default(uuid()) @db.Uuid
  hotelId        String          @map("hotel_id") @db.Uuid
  name           String
  code           String
  description    String?
  maxGuests      Int             @default(2) @map("max_guests")
  bedConfig      String          @map("bed_config")
  basePriceMinor Int             @map("base_price_minor")
  currency       String          @default("BDT") @db.Char(3)
  amenities      Json            @default("[]")
  images         Json            @default("[]")
  sortOrder      Int             @default(0) @map("sort_order")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  hotel          Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms          HotelRoom[]
  hotelBookings  HotelBooking[]

  @@unique([hotelId, code])
  @@index([hotelId, isActive])
  @@map("room_types")
}

model HotelRoom {
  id             String          @id @default(uuid()) @db.Uuid
  hotelId        String          @map("hotel_id") @db.Uuid
  roomTypeId     String          @map("room_type_id") @db.Uuid
  roomNumber     String          @map("room_number")
  floor          String?
  status         HotelRoomStatus @default(AVAILABLE)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  hotel          Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType       RoomType        @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  hotelBookings  HotelBooking[]
  nightsStayed   HotelRoomNight[]

  @@unique([hotelId, roomNumber])
  @@index([roomTypeId, status])
  @@map("hotel_rooms")
}

model HotelBooking {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @map("order_id") @db.Uuid
  hotelId           String            @map("hotel_id") @db.Uuid
  roomTypeId        String            @map("room_type_id") @db.Uuid
  roomId            String            @map("room_id") @db.Uuid
  hotelName         String            @map("hotel_name")
  hotelSlug         String            @map("hotel_slug")
  roomTypeName      String            @map("room_type_name")
  roomNumber        String            @map("room_number")
  checkInDate       String            @map("check_in_date")
  checkOutDate      String            @map("check_out_date")
  checkInTime       String            @default("14:00") @map("check_in_time")
  nights            Int               @map("nights")
  guestsCount       Int               @default(2) @map("guests_count")
  nightlyPriceMinor Int               @map("nightly_price_minor")
  totalMinor        Int               @map("total_minor")
  currency          String            @default("BDT") @db.Char(3)
  status            OrderItemStatus   @default(RESERVED)
  checkedInAt       DateTime?         @map("checked_in_at") @db.Timestamptz(6)
  checkedInById     String?           @map("checked_in_by_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  hotel             Hotel             @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  roomType          RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  room              HotelRoom         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  checkedInBy       User?             @relation("HotelBookingCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  nightsStayed      HotelRoomNight[]

  @@index([orderId])
  @@index([roomId, checkInDate])
  @@index([hotelId, status])
  @@map("hotel_bookings")
}

model HotelRoomNight {
  id              String            @id @default(uuid()) @db.Uuid
  hotelBookingId  String            @map("hotel_booking_id") @db.Uuid
  roomId          String            @map("room_id") @db.Uuid
  stayDate        String            @map("stay_date")
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  hotelBooking    HotelBooking      @relation(fields: [hotelBookingId], references: [id], onDelete: Cascade)
  room            HotelRoom         @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([hotelBookingId, stayDate])
  @@index([roomId, stayDate])
  @@map("hotel_room_nights")
}

// ---------------------------------------------------------------------------
// Dining
//
// - Venues are admin-managed. `vendorUserId` is reserved for a future vendor
//   role (null = platform-managed); no code reads it yet.
// - Table occupancy is one row per table per hour in `table_slots`; a partial
//   unique index (SQL migration) prevents double booking, like `booking_slots`.
// - Food delivery targets a tourist's own sunbed booking (`order_items`) at the
//   venue's beach point. Names, codes and prices are snapshotted on the order.
// ---------------------------------------------------------------------------

model DiningVenue {
  id                      String          @id @default(uuid()) @db.Uuid
  code                    String          @unique
  name                    String
  nameBn                  String?         @map("name_bn")
  kind                    DiningVenueKind
  description             String?
  address                 String?
  contactPhone            String?         @map("contact_phone")
  imageUrl                String?         @map("image_url")
  cuisineTags             String[]        @default([]) @map("cuisine_tags")
  beachPointId            String?         @map("beach_point_id") @db.Uuid
  openHour                Int             @map("open_hour")
  closeHour               Int             @map("close_hour")
  reservationsEnabled     Boolean         @default(false) @map("reservations_enabled")
  deliveryEnabled         Boolean         @default(false) @map("delivery_enabled")
  reservationDepositMinor Int             @default(0) @map("reservation_deposit_minor")
  currency                String          @default("BDT") @db.Char(3)
  sortOrder               Int             @default(0) @map("sort_order")
  isActive                Boolean         @default(true) @map("is_active")
  vendorUserId            String?         @map("vendor_user_id") @db.Uuid
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  beachPoint   BeachPoint?        @relation(fields: [beachPointId], references: [id], onDelete: Restrict)
  vendor       User?              @relation("VenueVendor", fields: [vendorUserId], references: [id], onDelete: SetNull)
  categories   MenuCategory[]
  menuItems    MenuItem[]
  tables       DiningTable[]
  reservations TableReservation[]
  foodOrders   FoodOrder[]

  @@index([beachPointId, isActive])
  @@index([kind, isActive])
  @@map("dining_venues")
}

model MenuCategory {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  name      String
  nameBn    String?  @map("name_bn")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  venue DiningVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@unique([venueId, name])
  @@unique([id, venueId])
  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(uuid()) @db.Uuid
  venueId     String   @map("venue_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  nameBn      String?  @map("name_bn")
  description String?
  priceMinor  Int      @map("price_minor")
  currency    String   @default("BDT") @db.Char(3)
  isAvailable Boolean  @default(true) @map("is_available")
  sortOrder   Int      @default(0) @map("sort_order")
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue          DiningVenue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  // Composite FK guarantees the category belongs to the same venue.
  category       MenuCategory    @relation(fields: [categoryId, venueId], references: [id, venueId], onDelete: Cascade)
  foodOrderItems FoodOrderItem[]

  @@index([venueId, isAvailable])
  @@index([categoryId, sortOrder])
  @@map("menu_items")
}

model DiningTable {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  code      String   @unique
  seats     Int
  isActive  Boolean  @default(true) @map("is_active")
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue        DiningVenue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  reservations TableReservation[]
  slots        TableSlot[]

  @@index([venueId, isActive])
  @@map("dining_tables")
}

model TableReservation {
  id            String            @id @default(uuid()) @db.Uuid
  publicRef     String            @unique @map("public_ref")
  touristId     String            @map("tourist_id") @db.Uuid
  venueId       String            @map("venue_id") @db.Uuid
  tableId       String            @map("table_id") @db.Uuid
  venueCode     String            @map("venue_code")
  venueName     String            @map("venue_name")
  tableCode     String            @map("table_code")
  partySize     Int               @map("party_size")
  startAt       DateTime          @map("start_at") @db.Timestamptz(6)
  endAt         DateTime          @map("end_at") @db.Timestamptz(6)
  status        ReservationStatus @default(CONFIRMED)
  depositMinor  Int               @default(0) @map("deposit_minor")
  currency      String            @default("BDT") @db.Char(3)
  note          String?
  placedAt      DateTime          @default(now()) @map("placed_at") @db.Timestamptz(6)
  cancelledAt   DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancelReason  String?           @map("cancel_reason")
  cancelledById String?           @map("cancelled_by_id") @db.Uuid
  checkedInAt   DateTime?         @map("checked_in_at") @db.Timestamptz(6)
  checkedInById String?           @map("checked_in_by_id") @db.Uuid

  tourist     User        @relation("ReservationTourist", fields: [touristId], references: [id], onDelete: Restrict)
  venue       DiningVenue @relation(fields: [venueId], references: [id], onDelete: Restrict)
  table       DiningTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  cancelledBy User?       @relation("ReservationCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  checkedInBy User?       @relation("ReservationCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  slots       TableSlot[]
  payments    Payment[]

  @@index([touristId, placedAt])
  @@index([venueId, startAt])
  @@index([tableId, startAt])
  @@index([status, startAt])
  @@map("table_reservations")
}

model TableSlot {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  tableId       String   @map("table_id") @db.Uuid
  slotStart     DateTime @map("slot_start") @db.Timestamptz(6)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reservation TableReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table       DiningTable      @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@unique([reservationId, slotStart])
  @@index([tableId, slotStart])
  @@index([slotStart])
  @@map("table_slots")
}

model FoodOrder {
  id             String          @id @default(uuid()) @db.Uuid
  publicRef      String          @unique @map("public_ref")
  touristId      String          @map("tourist_id") @db.Uuid
  venueId        String          @map("venue_id") @db.Uuid
  orderItemId    String          @map("order_item_id") @db.Uuid
  venueCode      String          @map("venue_code")
  venueName      String          @map("venue_name")
  sunbedCode     String          @map("sunbed_code")
  beachPointCode String          @map("beach_point_code")
  beachPointName String          @map("beach_point_name")
  status         FoodOrderStatus @default(PLACED)
  subtotalMinor  Int             @map("subtotal_minor")
  totalMinor     Int             @map("total_minor")
  currency       String          @default("BDT") @db.Char(3)
  note           String?
  placedAt       DateTime        @default(now()) @map("placed_at") @db.Timestamptz(6)
  preparingAt    DateTime?       @map("preparing_at") @db.Timestamptz(6)
  readyAt        DateTime?       @map("ready_at") @db.Timestamptz(6)
  deliveredAt    DateTime?       @map("delivered_at") @db.Timestamptz(6)
  cancelledAt    DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  cancelReason   String?         @map("cancel_reason")
  cancelledById  String?         @map("cancelled_by_id") @db.Uuid
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tourist     User            @relation("FoodOrderTourist", fields: [touristId], references: [id], onDelete: Restrict)
  venue       DiningVenue     @relation(fields: [venueId], references: [id], onDelete: Restrict)
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  cancelledBy User?           @relation("FoodOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items       FoodOrderItem[]
  payments    Payment[]

  @@index([touristId, placedAt])
  @@index([venueId, status, placedAt])
  @@index([orderItemId])
  @@map("food_orders")
}

model FoodOrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  foodOrderId    String   @map("food_order_id") @db.Uuid
  menuItemId     String   @map("menu_item_id") @db.Uuid
  itemName       String   @map("item_name")
  unitPriceMinor Int      @map("unit_price_minor")
  quantity       Int
  totalMinor     Int      @map("total_minor")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  foodOrder FoodOrder @relation(fields: [foodOrderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([foodOrderId])
  @@index([menuItemId])
  @@map("food_order_items")
}
